
# PostgreSQL

# PostgreSQL credentials: choose your own strong password.
POSTGRES_USER=replace_with_user_name
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=replace_with_any_name

# n8n

# Pin a specific version instead of using "latest".
N8N_VERSION=choose_your_version_or_jsut_write_latest
# Keep this exact key safe and unchanged for this n8n instance.
N8N_ENCRYPTION_KEY=replace_with_a_long_random_secret

# ngrok
# Replace with your ngrok HTTPS domain and authentication token.

# Your ngrok HTTPS domain.
NGROK_URL=replace_with_your_url
# Paste your private ngrok authtoken here.
NGROK_AUTHTOKEN=replace_with_your_ngrok_auth_token
